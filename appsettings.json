    "sessionReconnect": {
      "enabled": true,
      "intervalMinutes": 360,
      "minIntervalMinutes": 15
    },
    "stallRecovery": {
      "enabled": true,
      "noLogActivitySeconds": 3600,
      "auditScanMaxSeconds": 12000,
      "sendSessionAlert": false,
      "sendStallAlert": true,
      "postKillCooldownSeconds": 120
    }
  },
  "reconciliation": {
    "enabled": true,
    "reconcileStatusSetsOnStart": false,
    "downtimeThresholdSeconds": 0
  },
  "auditPoller": {
    "enabled": true,
    "lookbackSeconds": 120,
    "overlapSeconds": 5,
    "restartOverlapSeconds": 60,
    "initialLookbackSeconds": 14400,
    "maxUnprocessedPerPoll": 50,
    "folderGuidCache": {
      "warmOnScheduledReconciliation": true,
      "warmWatchRootsOnStart": false,
      "warmSheetsFoldersOnStart": true,
      "filterByParentGuidCache": true,
      "parentGuidFilterExemptActionCodes": [1012],
      "maxSheetsFoldersToWarm": 250,
      "folderCacheTtlSeconds": 86400
    },
    "metadataCacheTtlSeconds": 3600,
    "negativeCacheTtlSeconds": 1800,
    "pageSize": 500,
    "maxPagesPerPoll": 300,
    "fullScanSchedule": {
      "times": ["06:00", "18:00"],
      "preempt": {
        "enabled": true,
        "checkEveryNFolders": 1,
        "skipSheetIndex": true
      }
    },
    "fallbackToFullScan": false,
    "qcPrependAuditActions": [
      "DOCUMENT_MODIFY",
      "DOCUMENT_ATTR",
      "DOCUMENT_CIN",
      "DOCUMENT_FILE_REP",
      "DOCUMENT_VERSION",
      "DOCUMENT_CREATE",
      "DOCUMENT_STATE"
    ],
    "workflowTriggers": {
      "enabled": true,
      "suppressBaselineIndexStateTransition": true,
      "processingGoLiveUtc": "2026-06-12T14:50:00Z",
      "recordStateHistory": true,
      "recordAttributeHistory": true,
      "recordTransitions": true,
      "recordFromProcessor": true,
      "recordProcessingJobs": true,
      "notifyOnStateChange": true,
      "qcPdfNotificationsOnly": true,
      "qcPdfEventsOnly": true,
      "ignoreStateChangeFromAutomation": true,
      "automationPwUsernames": ["SVC_TYPSA_ARCHIVIST"],
      "automationPwUserNumbers": []
    }
  },
  "qcCommentSync": {
    "enabled": false,
    "processorVersion": "1.0.0",
    "stagingRoot": "C:\\QC_E2E_RealRun\\comment_sync",
    "retainTempFiles": false,
    "pythonExecutable": "python",
    "commentExtractScript": "tools\\overlay\\qc_pdf_comments.py",
    "parserVersion": "1.0.0",
    "auditActions": ["DOCUMENT_MODIFY", "DOCUMENT_FILE_REP", "DOCUMENT_VERSION", "DOCUMENT_ATTR", "DOCUMENT_STATE"],
    "reviewerAuthorPatterns": ["(?i)reviewer|qc|typsa"],
    "statusMappings": {
      "open": ["Open", "None", "", "Unknown"],
      "resolved": ["Completed", "Accepted", "Checked"],
      "closed": ["Closed", "Cancelled"]
    },
    "targetStates": {
      "redlinesReceived": "Redlines Received",
      "qcFinalizing": "Initiate Verification",
      "completed": "Verified",
      "error": "Error Needs Attention"
    }
  },
  "database": {
    "enabled": true,
    "provider": "SqlServer",
    "allowWritesInDryRun": false,
    "logPlannedEventsInDryRun": false,
    "connectionString": "Server=localhost\\SQLEXPRESS;Database=QC_Pipeline;Trusted_Connection=True;TrustServerCertificate=True;",
    "commandTimeout": 60,
    "retention": {
      "auditEventsDays": 90,
      "auditEventsProcessedOnly": true
    }
  },
  "telemetry": {
    "automationEvents": {
      "enabled": true,
      "jsonLogRetentionDays": 7,
      "jsonLogMaxFileSizeMb": 50,
      "excludeCodes": ["WATCH_TICK_START", "WATCH_TICK_SLEEP", "WORKER_NO_JOB"]
    }
  },
  "notifications": {
    "enabled": true,
    "rollbackWhenEmailAttributesMissing": false,
    "enqueueAsJob": true,
    "provider": "MicrosoftGraph",
    "dryRun": false,
    "adminRecipients": [],
    "outputRoot": "notifications",
    "dedupe": {
      "enabled": true,
      "storePath": "notifications\\dedupe\\sent-keys.jsonl",
