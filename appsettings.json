    "pwExportThrottleMs": 500,
    "retentionDays": 14,
    "cleanupEnabled": false,
    "cleanImmediateExportScratch": false,
    "historyRetention": {
      "enabled": true,
      "keepRecentCount": 8,
      "dailyDays": 7,
      "weeklyWeeks": 26,
      "maxGbPerFolder": 10
    },
    "pwSheetCache": true,
    "pwSheetReusePolicy": "PdfTimestamp"
  },
  "QCProcess": {
    "DefaultProcessType": "production",
    "EnableLegacySiblingStateSync": false,
