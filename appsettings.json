      "Ready for QC": {
        "enabled": false,
        "eventType": "READY_FOR_QC",
        "to": ["reviewers"],
        "cc": ["designers"],
        "actionRequired": "Reviewer to begin QC review."
      },
      "Originated": {
        "enabled": true,
        "eventType": "READY_FOR_QC",
        "to": ["reviewers"],
        "cc": [],
        "actionRequired": "Reviewer to begin QC review."
      },
      "Redlines Received": {
        "enabled": true,
