{
  "$schema": "./appsettings.schema.json",
  "projectWise": {
    "datasourceName": "typsa-us-pw.bentley.com:typsa-us-pw-03",
    "credentialPath": "C:\\PW_QC_LOCAL\\pw_cred.txt",
    "qcReviewTypeAttributes": {
      "enabledEnvironments": ["Caltrans", "ADOT"]
    },
    "clearTriggerTagOnSuccess": true,
    "fileOpThrottleMs": 1000,
    "watchList": {
      "roots": [
        {
          "path": "Documents\\AZDOT 2024",
          "sheetsPathFromProject": "CADD\\Sheets",
          "enableQcPrepend": true,
          "enableQcCommentSync": false,
          "enableStatusSet": true,
          "projectDepth": 1,
          "qcRendition": {
            "profileName": "Quality Control - PDF ANSI D",
            "sourceDocumentPattern": "%.dgn",
            "useFolderProfileWhenUnspecified": true,
            "outputFolderRelative": "."
          }
        },
        {
          "path": "Documents\\AZDOT",
          "sheetsPathFromProject": "CADD\\Sheets",
          "enableQcPrepend": true,
          "enableQcCommentSync": false,
          "enableStatusSet": true,
          "projectDepth": 1,
          "qcRendition": {
            "profileName": "Quality Control - PDF ANSI D",
            "sourceDocumentPattern": "%.dgn",
            "useFolderProfileWhenUnspecified": true,
            "outputFolderRelative": "."
          }
        },
        {
          "path": "Documents\\Caltrans\\CAFWY2200-I-15_ELPSE",
          "sheetsPathFromProject": "CADD\\Sheets",
          "enableQcPrepend": true,
          "enableQcCommentSync": false,
          "enableStatusSet": true,
          "projectDepth": 2,
          "qcRendition": {
            "profileName": "Quality Control - Caltrans BW ANSI D",
            "sourceDocumentPattern": "%.dgn",
            "useFolderProfileWhenUnspecified": true,
            "outputFolderRelative": "."
          }
        }
      ]
    }
  },
  "dryRun": false,
  "fileOpThrottleMs": 1000,
  "runtime": {
    "displayTimeZoneId": "US Mountain Standard Time"
  },
  "filters": {
    "whitelist": { "enabled": false, "paths": [] },
    "blacklist": {
      "paths": [
        "pw:\\\\typsa-us-pw.bentley.com:typsa-us-pw-03\\Documents\\AZDOT\\AZFWY2211_I17-303L-TI\\",
        "pw:\\\\typsa-us-pw.bentley.com:typsa-us-pw-03\\Documents\\AZDOT\\AZFWY2302-006\\",
        "pw:\\\\typsa-us-pw.bentley.com:typsa-us-pw-03\\Documents\\AZDOT\\AZFWY2302-007\\",
        "pw:\\\\typsa-us-pw.bentley.com:typsa-us-pw-03\\Documents\\AZDOT\\AZFWY2302-008\\",
        "pw:\\\\typsa-us-pw.bentley.com:typsa-us-pw-03\\Documents\\AZDOT\\AZFWY2302-009\\",
        "pw:\\\\typsa-us-pw.bentley.com:typsa-us-pw-03\\Documents\\AZDOT\\_ADOT_ORD_Help_WorkFlows\\",
        "pw:\\\\typsa-us-pw.bentley.com:typsa-us-pw-03\\Documents\\AZDOT\\HOLD\\"
      ],
      "patterns": []
    }
  },
  "triggers": {
    "rules": [
      {
        "id": "status-set-folder",
        "enabled": true,
        "priority": 50,
        "jobType": "STATUS_SET_GEN",
        "triggerType": "pw",
        "when": {},
        "exclude": { "pathRegexAny": [], "fileNameRegexAny": [] },
        "grouping": { "enabled": true, "groupBy": "folder" }
      },
      {
        "id": "qc-comment-status-pw",
        "enabled": true,
        "priority": 105,
        "jobType": "QC_COMMENT_STATUS_SYNC",
        "triggerType": "pw",
        "when": {
          "extensions": [".pdf"],
          "fileNameRegexAny": ["(?i)-qc\\.pdf$"]
        },
        "requireAll": ["extensions", "fileNameRegexAny"],
        "exclude": { "pathRegexAny": [], "fileNameRegexAny": [] },
        "grouping": { "enabled": false, "groupBy": "file" }
      },
      {
        "id": "qc-prepend-pw-desc",
        "enabled": true,
        "priority": 110,
        "jobType": "QC_PREPEND",
        "triggerType": "pw",
        "when": {
          "extensions": [".pdf"],
          "descriptionContainsAny": ["QC_Archivist"]
        },
        "requireAll": ["extensions", "descriptionContainsAny"],
        "exclude": { "pathRegexAny": [], "fileNameRegexAny": [] },
        "grouping": { "enabled": false, "groupBy": "file" }
      },
      {
        "id": "qc-prepend-local-any-pdf",
        "enabled": true,
        "priority": 100,
        "jobType": "QC_PREPEND",
        "triggerType": "fs",
        "when": { "extensions": [".pdf"], "fileNameRegexAny": ["(?i)\\.pdf$"] },
        "requireAll": ["extensions", "fileNameRegexAny"],
        "exclude": {
          "pathRegexAny": [],
          "fileNameRegexAny": ["(?i)^_StatusSet\\.pdf$", "(?i)^status_set_replace_.*\\.pdf$"]
        },
        "grouping": { "enabled": false, "groupBy": "file" }
      }
    ]
  },
  "queue": {
    "rootDir": "C:\\QC_E2E_RealRun\\queue",
    "recover": { "maxAttempts": 3 },
    "lockAcquireTimeoutMs": 60000,
    "lockAcquireSleepMs": 150,
    "moveRetryAttempts": 12,
    "moveRetrySleepMs": 200,
    "repairDuplicateJobsOnStartup": true,
    "selection": {
      "preferJobTypes": ["STATUS_SET_GEN", "QC_PREPEND", "QC_RENDITION", "QC_COMMENT_STATUS_SYNC", "QC_REPORTING_SCAN"]
    }
  },
  "processors": {
    "processorMap": {
      "QC_PREPEND": "Invoke-QCPrependProcessor",
      "QC_RENDITION": "Invoke-QCRenditionProcessor",
      "QC_COMMENT_STATUS_SYNC": "Invoke-QCCommentStatusSyncProcessor",
      "QC_REPORTING_SCAN": "Invoke-QCReportingScanProcessor"
    },
    "dryRun": { "allowStateChange": false, "invokeHandler": true }
  },
  "qcPackage": {
    "enabled": true,
    "canonicalDocumentRole": "ProductionPdf",
    "fallbackOrder": ["ProductionPdf", "QcPdf", "Dgn"],
    "namingRules": {
      "dgnExtensions": [".dgn"],
      "productionPdfExtensions": [".pdf"],
      "qcPdfSuffixes": ["_QC", "-QC", "_QC_HISTORY"]
    },
    "statePrecedence": [
      "Error Needs Attention",
      "QC Initiated",
      "QC Finalizing",
      "Ready for QC",
      "Corrections Received",
      "Redlines Received",
      "In Production"
    ],
    "userOwnedAttributes": [
      "QC_Review_Type",
      "QC_Designer_Email",
      "QC_Reviewer_Email",
      "QC_Checker_Email",
      "QC_Originator",
      "QC_Due_Date"
    ],
    "automationOwnedAttributes": [
      "QC_Prepend_Status",
      "QC_Last_Automation_Run",
      "QC_Last_Email_Sent",
      "QC_Automation_JobId",
      "QC_Error_Message",
      "QC_PackageId",
      "QC_Source_Dgn_Guid",
      "QC_Production_Pdf_Guid",
      "QC_QcPdf_Guid"
    ],
    "syncUserAttributesFromNonCanonical": true,
    "nonCanonicalUserEditBehavior": "CopyOnceThenNormalize",
    "writeAutomationStatusTo": ["ProductionPdf", "QcPdf"]
  },
  "workers": {
    "maxParallel": 2,
    "maxJobsPerWorker": 25,
    "leaseSeconds": 600,
    "idleSleepMs": 400,
    "spawnStaggerMs": 150
  },
  "qcRendition": {
    "enabled": false,
    "deferReadyForQcNotification": false,
    "readinessStorePath": "C:\\QC_E2E_RealRun\\rendition-readiness",
    "defaultSourceDocumentPattern": "%.dgn",
    "deriveSourceFromQcPdf": true,
    "makeSinglePlotRequest": false,
    "completion": {
      "mode": "submitOnly",
      "pollAttempts": 1,
      "pollIntervalSeconds": 0,
      "fileNamePattern": "{stem}*.pdf"
    },
    "folderOverrides": []
  },
  "qcPrepend": {
    "historyRoot": "C:\\QC_E2E_RealRun\\history",
    "outputRoot": "C:\\QC_E2E_RealRun\\output",
    "tempRoot": "C:\\QC_E2E_RealRun\\temp",
    "enableOverlay": true,
    "mode": "legacyPw",
    "qpdfExePath": "tools\\qpdf\\bin\\qpdf.exe",
    "reviewStamps": {
      "enabled": true,
      "populateTextFields": false,
      "stampHeightPt": 300,
      "stampPositionPt": {
        "x": -400,
        "y": 0
      },
      "peerReview": {
        "stampPath": "stamps/Peer_Review_Stamp.pdf"
      },
      "independentCheck": {
        "stampPath": "stamps/IC_Stamp.pdf"
      }
    }
  },
  "statusSet": {
    "mode": "native",
    "writeBackToPW": true,
    "forceRebuild": false,
    "incrementalMode": true,
    "localRoot": "C:\\QC_E2E_RealRun\\statussets",
    "stagingRoot": "C:\\QC_E2E_RealRun\\statussets_staging",
    "manifestFileName": "_statusset.manifest.json",
    "statusSetPdfName": "_StatusSet.pdf",
    "atomicReplaceEnabled": true,
    "dryRunOperationReport": true,
    "pwExportThrottleMs": 500,
    "retentionDays": 14,
    "cleanupEnabled": false,
    "cleanImmediateExportScratch": false,
    "pwSheetCache": true,
    "pwSheetReusePolicy": "PdfTimestamp"
  },
  "qcWorkflow": {
    "enabled": true,
    "strictMode": false,
    "dryRunWriteback": false,
    "mode": "StateAndAttributes",
    "workflowName": "TYPSA QC",
    "expectedWorkflowName": "TYPSA QC",
    "states": {
      "production": "In Production",
      "qcInitiated": "QC Initiated",
      "qcReceived": "Ready for QC",
      "readyForQc": "Ready for QC",
      "redlinesReceived": "Redlines Received",
      "correctionsReceived": "Corrections Received",
      "qcFinalizing": "QC Finalizing",
      "complete": "QC Complete",
      "error": "Error Needs Attention"
    },
    "reviewTypes": {
      "productionQc": "Production QC",
      "peerReview": "Peer Review",
      "independentCheck": "Independent Check"
    },
    "defaultReviewType": "Production QC",
    "defaultStateAfterPrepend": "Ready for QC",
    "stateAfterSuccessfulPrepend": "Ready for QC",
    "stateAfterFailedPrepend": "Error Needs Attention",
    "defaultPrependTrigger": "initialQcPdf",
    "stateAfterPrependByTrigger": {
      "initialQcPdf": "Ready for QC",
      "finalQcComplete": "QC Complete"
    },
    "autoSetState": true,
    "autoWriteAttributes": true,
    "attributeMap": {
      "qcActive": "QC_Active",
      "reviewType": "QC_Review_Type",
      "cycleId": "QC_Cycle_ID",
      "cycleNumber": "QC_Cycle_Number",
      "designerEmail": "QC_Designer_Email",
      "reviewerEmail": "QC_Reviewer_Email",
      "checkerEmail": "QC_Checker_Email",
      "assignedTo": "QC_Assigned_To",
      "lastActionBy": "QC_Last_Action_By",
      "lastActionDate": "QC_Last_Action_Date",
      "status": "QC_Status",
      "historyPdfPath": "QC_History_PDF_Path",
      "latestOverlayPdfPath": "QC_Latest_Overlay_PDF_Path",
      "sourceDocumentPath": "QC_Source_Document_Path",
      "automationLastRun": "QC_Automation_Last_Run",
      "automationResult": "QC_Automation_Result",
      "automationError": "QC_Automation_Error"
    }
  },
  "qcReporting": {
    "enabled": true,
    "snapshotRoot": "metrics\\qc",
    "staleDays": 14,
    "includeWorkflowStateCounts": true,
    "scanSubtree": true,
    "scheduledIntervalMinutes": 60
  },
  "watcher": {
    "mode": "audit_only",
    "continuous": true,
    "idleSleepMs": 500
  },
  "reconciliation": {
    "enabled": true,
    "reconcileStatusSetsOnStart": false,
    "downtimeThresholdSeconds": 0
  },
  "auditPoller": {
    "enabled": true,
    "lookbackSeconds": 120,
    "overlapSeconds": 5,
    "restartOverlapSeconds": 60,
    "initialLookbackSeconds": 14400,
    "maxUnprocessedPerPoll": 50,
    "folderGuidCache": {
      "warmWatchRootsOnStart": true,
      "warmSheetsFoldersOnStart": true,
      "maxSheetsFoldersToWarm": 250,
      "folderCacheTtlSeconds": 86400
    },
    "metadataCacheTtlSeconds": 3600,
    "negativeCacheTtlSeconds": 1800,
    "pageSize": 500,
    "maxPagesPerPoll": 100,
    "fullScanSchedule": {
      "times": ["06:00", "18:00"]
    },
    "fallbackToFullScan": false,
    "qcPrependAuditActions": [
      "DOCUMENT_MODIFY",
      "DOCUMENT_ATTR",
      "DOCUMENT_CIN",
      "DOCUMENT_FILE_REP",
      "DOCUMENT_VERSION",
      "DOCUMENT_CREATE",
      "DOCUMENT_STATE"
    ],
    "workflowTriggers": {
      "enabled": true,
      "recordStateHistory": true,
      "recordAttributeHistory": true,
      "recordTransitions": true,
      "recordFromProcessor": true,
      "recordProcessingJobs": true,
      "notifyOnStateChange": true,
      "qcPdfNotificationsOnly": true,
      "ignoreStateChangeFromAutomation": false,
      "automationPwUsernames": ["SVC_TYPSA_ARCHIVIST"],
      "automationPwUserNumbers": []
    }
  },
  "qcCommentSync": {
    "enabled": false,
    "processorVersion": "1.0.0",
    "stagingRoot": "C:\\QC_E2E_RealRun\\comment_sync",
    "retainTempFiles": false,
    "pythonExecutable": "python",
    "commentExtractScript": "overlay\\qc_pdf_comments.py",
    "parserVersion": "1.0.0",
    "auditActions": ["DOCUMENT_MODIFY", "DOCUMENT_FILE_REP", "DOCUMENT_VERSION", "DOCUMENT_ATTR", "DOCUMENT_STATE"],
    "reviewerAuthorPatterns": ["(?i)reviewer|qc|typsa"],
    "statusMappings": {
      "open": ["Open", "None", "", "Unknown"],
      "resolved": ["Completed", "Accepted", "Checked"],
      "closed": ["Closed", "Cancelled"]
    },
    "targetStates": {
      "redlinesReceived": "Redlines Received",
      "correctionsReceived": "Corrections Received",
      "qcFinalizing": "QC Finalizing",
      "completed": "QC Complete",
      "error": "Error Needs Attention"
    }
  },
  "database": {
    "enabled": true,
    "provider": "SqlServer",
    "allowWritesInDryRun": false,
    "logPlannedEventsInDryRun": false,
    "connectionString": "Server=localhost\\SQLEXPRESS;Database=QC_Pipeline;Trusted_Connection=True;TrustServerCertificate=True;",
    "commandTimeout": 60,
    "retention": {
      "auditEventsDays": 90,
      "auditEventsProcessedOnly": true
    }
  },
  "notifications": {
    "enabled": true,
    "enqueueAsJob": true,
    "provider": "MicrosoftGraph",
    "dryRun": false,
    "adminRecipients": [],
    "outputRoot": "notifications",
    "dedupe": {
      "enabled": true,
      "storePath": "notifications\\dedupe\\sent-keys.jsonl",
      "keyFields": ["documentGuid", "eventType", "currentState"]
    },

    "email": {
      "bodyFormat": "Html",
      "templatePath": "email/templates/qc_notification.html",
      "logoPath": "email/typsalogo.png.webp",
      "environment": "Production",
      "subjectTemplate": "[{ReviewType}] {ProjectName} | {DocumentName} | {WorkflowState}",
      "qcPdfUrlTemplate": "",
      "pwLinkBaseUrl": "https://connect-projectwisewac.bentley.com/pwlink/",
      "pwLinkApp": "pwe"
    },
    "attributes": {
      "reviewerEmailField": "EM_Reviewer_Email",
      "designerEmailField": "EM_Designer_Email",
      "ccEmailField": "CcEmails",
      "checkerEmailField": "EM_Checker_Email",
      "qcPdfUrlField": "",
      "projectNumberField": "",
      "reviewTypeField": ""
    },
    "events": {
      "QC Received": {
        "enabled": false,
        "eventType": "QC_RECEIVED",
        "to": ["reviewers"],
        "cc": ["designers"],
        "actionRequired": "Reviewer to begin QC review."
      },
      "Ready for QC": {
        "enabled": true,
        "eventType": "READY_FOR_QC",
        "to": ["reviewers"],
        "cc": ["designers"],
        "actionRequired": "Reviewer to begin QC review."
      },
      "Redlines Received": {
        "enabled": true,
        "eventType": "REDLINES_RECEIVED",
        "to": ["designers"],
        "cc": ["reviewers"],
        "actionRequired": "Designer to address QC comments and return corrections."
      },
      "Corrections Received": {
        "enabled": true,
        "eventType": "CORRECTIONS_RECEIVED",
        "to": ["reviewers"],
        "cc": ["designers"],
        "actionRequired": "Reviewer to verify corrections and approve or return redlines."
      },
      "Error Needs Attention": {
        "enabled": true,
        "eventType": "QC_ERROR",
        "to": ["reviewers", "designers"],
        "cc": [],
        "actionRequired": "Manual review required."
      },
      "QC Complete": {
        "enabled": true,
        "eventType": "QC_COMPLETE",
        "to": ["designers", "reviewers"],
        "cc": [],
        "actionRequired": "QC review cycle is complete."
      }
    }
  }
}
