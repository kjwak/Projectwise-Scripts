        "stampPath": "stamps/Review_Stamp.pdf"
      },
      "independentCheck": {
        "stampPath": "stamps/Check_Stamp.pdf"
      }
    }
  },
  "statusSetBatching": {
    "enabled": true,
    "intervalMinutes": 15,
    "maxFoldersPerRun": 100,
    "quietPeriodSeconds": 120,
    "staleWarningHours": 24,
    "dirtyFolderStorePath": "_watcher/statusset-dirty-folders.json",
    "processOnWatcherStart": false
  },
  "statusSet": {
    "mode": "native",
    "writeBackToPW": true,
    "forceRebuild": false,
    "incrementalMode": true,
    "localRoot": "C:\\QC_E2E_RealRun\\statussets",
    "stagingRoot": "C:\\QC_E2E_RealRun\\statussets_staging",
    "manifestFileName": "_statusset.manifest.json",
    "statusSetPdfName": "_StatusSet.pdf",
