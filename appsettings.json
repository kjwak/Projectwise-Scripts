  "watcher": {
    "mode": "audit_only",
    "continuous": true,
    "idleSleepMs": 5000,
    "sessionAlerts": {
      "enabled": true,
      "recipients": ["jflint@aztec.us"],
      "importance": "high",
      "dedupeMinutes": 60,
      "probeIntervalTicks": 60,
      "staleAuditLagSeconds": 180,
      "enableAuditStallDetection": false
